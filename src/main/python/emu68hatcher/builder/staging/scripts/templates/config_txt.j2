{% macro hdmi_settings(comments) %}
{% if force_hdmi %}
{% if comments %}

# Enables HDMI output even when no display is detected at boot.
{% endif %}
hdmi_force_hotplug=1
{% endif %}
{% if is_custom_mode and custom_cvt %}
{% if comments %}
# Uses the custom DMT timing mode.
{% endif %}
hdmi_group=2
{% if comments %}
# Selects the custom HDMI mode number.
{% endif %}
hdmi_mode=87
{% if comments %}
# Defines the custom HDMI timing values.
{% endif %}
hdmi_cvt={{ custom_cvt }}
{% endif %}
{% for mode in available_modes if mode.name == screen_mode %}
{% if mode.hdmi_group is defined %}
{% if comments %}
# Selects the HDMI timing group for {{ mode.friendly_name }}.
{% endif %}
hdmi_group={{ mode.hdmi_group }}
{% endif %}
{% if mode.hdmi_mode is defined %}
{% if comments %}
# Selects the HDMI mode number for {{ mode.friendly_name }}.
{% endif %}
hdmi_mode={{ mode.hdmi_mode }}
{% endif %}
{% if mode.hdmi_cvt is defined %}
{% if comments %}
# Defines the custom timing values for {{ mode.friendly_name }}.
{% endif %}
hdmi_cvt={{ mode.hdmi_cvt }}
{% endif %}
{% if mode.max_framebuffer_width is defined %}
{% if comments %}
# Sets the maximum framebuffer width in pixels.
{% endif %}
max_framebuffer_width={{ mode.max_framebuffer_width }}
{% endif %}
{% if mode.max_framebuffer_height is defined %}
{% if comments %}
# Sets the maximum framebuffer height in pixels.
{% endif %}
max_framebuffer_height={{ mode.max_framebuffer_height }}
{% endif %}
{% endfor %}
{% if comments %}
# Stops the firmware shrinking the picture by its overscan margins on CEA modes.
{% endif %}
disable_overscan=1
{% endmacro %}
{% macro pistorm32_kernel() %}
{% if rgb2rtg_video %}
# RGB2RTG: the A1200's own picture on HDMI. Uninstalling it restores the #RGB2RTG-WAS: line.
kernel=kernel/Emu68-rgb2rtg.gz
#RGB2RTG-WAS: kernel={{ kernel_modern }}
{% else %}
kernel={{ kernel_modern }}
{% endif %}
{% endmacro %}
# Generated by Emu68 Hatcher.

{% if rgb2rtg_video %}
{{ hdmi_settings(false) -}}
cmdline=cmdline.txt
# RGB2RTG begin
dtoverlay=unicam,boot
hdmi_group={{ 2 if rgb2rtg_video == "ntsc" else 1 }}
hdmi_mode={{ 82 if rgb2rtg_video == "ntsc" else 31 }}
hdmi_force_mode=1
hdmi_pixel_encoding=2
dtoverlay={{ rgb2rtg_video }}
# RGB2RTG end

{% endif %}
{% if arm_boost_pi4 or usb_otg %}
# Raspberry Pi 4 hardware

# Applies the following settings only to Raspberry Pi 4 hardware.
[pi4]
{% if arm_boost_pi4 %}
# Uses the boosted Raspberry Pi 4 ARM clock when supported.
arm_boost=1
{% endif %}
{% if usb_otg %}
# Runs the USB-C controller in host mode for xhci.device unit 0.
otg_mode=1
{% endif %}
{% endif %}

# General boot

# Applies the following settings to every supported board.
[all]
# Hides the Raspberry Pi firmware splash screen.
disable_splash=1
# Starts the ARM processor in 64-bit mode for Emu68.
arm_64bit=1
# Waits this many seconds before the firmware loads the boot files.
bootcode_delay={{ bootcode_delay }}
# Waits this many seconds before loading the Emu68 kernel.
boot_delay={{ boot_delay }}
# Controls firmware warning overlays and throttling behaviour.
avoid_warnings={{ avoid_warnings }}

{% if memory_limit_mb or gpu_memory_mb or cpu_turbo %}
# CPU and memory
{% if memory_limit_mb %}

# Limits the ARM memory visible to the firmware in megabytes.
total_mem={{ memory_limit_mb }}
{% endif %}
{% if gpu_memory_mb %}
# Reserves this many megabytes of RAM for the GPU.
gpu_mem={{ gpu_memory_mb }}
{% endif %}
{% if cpu_turbo %}
# Keeps the ARM clock at the configured turbo frequency.
force_turbo=1
# Applies this voltage adjustment for the turbo frequency.
over_voltage={{ over_voltage }}
# Sets the ARM processor clock in megahertz.
arm_freq={{ arm_freq_mhz }}
{% endif %}
{% endif %}

{% if antenna %}
# CM4 wireless antenna
{% if antenna == "internal" %}

# Selects the internal CM4 wireless antenna.
dtparam=ant1
{% elif antenna == "external" %}

# Selects the external CM4 wireless antenna connector.
dtparam=ant2
{% endif %}
{% endif %}

{% if storage_overlays %}
# Emu68 storage

# Pi 3 and CM3 use the SDHC controller.
[pi3]
{{ storage_overlays.sdhc }}

# Pi Zero 2 uses the SDHC controller.
[pi02]
{{ storage_overlays.sdhc }}

# Pi 4, Pi 400 and CM4 use the eMMC controller.
[pi4]
{{ storage_overlays.emmc }}

# Applies the remaining settings to every supported board.
[all]
{% endif %}

{% if not rgb2rtg_video %}
# HDMI output
{{ hdmi_settings(true) }}
{% endif %}

{% if overlays %}
# Emu68 overlays
{% for overlay in overlays %}
{% if overlay.startswith("dtoverlay=emu68") %}

# Applies the selected Emu68 compatibility options.
{% elif overlay.startswith("dtoverlay=diagnostic") %}

# Runs the PiStorm bus memory test on the next boot.
{% elif overlay.startswith("dtoverlay=unicam") %}

# Configures the Unicam capture interface for Framethrower or C790.
{% else %}

# Loads an Emu68 device-tree overlay.
{% endif %}
{{ overlay }}
{% endfor %}
{% endif %}
{% if extra_config_lines %}

# Additional settings
{% for line in extra_config_lines %}

# User-defined config.txt directive.
{{ line }}
{% endfor %}
{% endif %}

# PiStorm model detection: GPIO inputs with pull-ups
[all]
gpio=0-27=ip
gpio=0-27=pu

# Stealth boot while keyboard reset holds GPIO 4 low
[gpio4=0]
{{ pistorm32_kernel() -}}
initramfs ps32lite-stealth-firmware.gz

# PiStorm32-lite
[all]
[gpio24=0]
{{ pistorm32_kernel() -}}
initramfs {{ rom_filename }}

# PiStorm16
[all]
[gpio24=1]
kernel={{ kernel_pistorm16 }}
initramfs {{ rom_filename }}

# Classic PiStorm
[all]
[gpio17=0]
kernel={{ kernel_classic }}
initramfs {{ rom_filename }}
